<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>
	<groupId>skerdudou</groupId>
	<artifactId>synoRight</artifactId>
	<version>0.3</version>
	<packaging>jar</packaging>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>25</maven.compiler.release>
	</properties>

	<dependencies>

		<dependency>
			<groupId>tools.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>3.2.3</version>
		</dependency>
		<dependency>
			<groupId>info.picocli</groupId>
			<artifactId>picocli</artifactId>
			<version>4.7.7</version>
		</dependency>
		<dependency>
			<groupId>com.formdev</groupId>
			<artifactId>flatlaf</artifactId>
			<version>3.7.2</version>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>6.1.3</version>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<build>
		<finalName>synoRight</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.16.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.6.0</version>
				<configuration>
					<!-- les tests ne doivent pas toucher la clé de chiffrement de l'utilisateur -->
					<systemPropertyVariables>
						<synoRight.keyFile>${project.build.directory}/test-synoRight.key</synoRight.keyFile>
						<synoRight.language>en</synoRight.language>
					</systemPropertyVariables>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.6.2</version>
				<executions>
					<execution>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>sk.synoAdmin.Main</mainClass>
									<manifestEntries>
										<Implementation-Version>${project.version}</Implementation-Version>
									</manifestEntries>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- mvn package -Pexe : application autonome target/dist/synoRight/synoRight.exe (runtime Java embarqué),
			menu Windows 11 compris (nécessite VS Build Tools + Windows SDK + certificat : native/create-cert.ps1).
			-Dnative.skip pour s'en passer. -->
		<profile>
			<id>exe</id>
			<properties>
				<native.skip>false</native.skip>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<version>3.2.0</version>
						<executions>
							<execution>
								<id>jpackage-input</id>
								<phase>package</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<!-- jpackage refuse une destination existante (et y crée des fichiers en lecture seule),
											et n'embarque que le jar autonome -->
										<attrib readonly="false">
											<fileset dir="${project.build.directory}/dist" erroronmissingdir="false" />
										</attrib>
										<delete dir="${project.build.directory}/dist" />
										<delete dir="${project.build.directory}/jpackage-input" />
										<copy file="${project.build.directory}/${project.build.finalName}.jar" todir="${project.build.directory}/jpackage-input" />
									</target>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.6.4</version>
						<executions>
							<execution>
								<id>jpackage</id>
								<phase>package</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>jpackage</executable>
									<arguments>
										<argument>--type</argument>
										<argument>app-image</argument>
										<argument>--name</argument>
										<argument>synoRight</argument>
										<argument>--input</argument>
										<argument>${project.build.directory}/jpackage-input</argument>
										<argument>--main-jar</argument>
										<argument>${project.build.finalName}.jar</argument>
										<argument>--main-class</argument>
										<argument>sk.synoAdmin.Main</argument>
										<argument>--dest</argument>
										<argument>${project.build.directory}/dist</argument>
										<!-- modules donnés par jdeps, + jdk.charsets pour l'ancien chiffrement (ISO-8859-2) -->
										<argument>--add-modules</argument>
										<argument>java.base,java.desktop,java.net.http,java.sql,jdk.charsets</argument>
										<argument>--app-version</argument>
										<argument>${project.version}</argument>
										<argument>--win-console</argument>
										<argument>--description</argument>
										<argument>synoRight</argument>
										<argument>--add-launcher</argument>
										<argument>synoRightGui=${project.basedir}/src/main/jpackage/synoRightGui.properties</argument>
									</arguments>
								</configuration>
							</execution>
							<execution>
								<id>native-menu</id>
								<phase>package</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<skip>${native.skip}</skip>
									<executable>powershell</executable>
									<arguments>
										<argument>-NoProfile</argument>
										<argument>-ExecutionPolicy</argument>
										<argument>Bypass</argument>
										<argument>-File</argument>
										<argument>${project.basedir}/native/build.ps1</argument>
										<argument>-AppDir</argument>
										<argument>${project.build.directory}/dist/synoRight</argument>
										<argument>-Version</argument>
										<argument>${project.version}</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
